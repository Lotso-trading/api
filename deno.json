{
  "name": "@polymarket-copy/api",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "imports": {
    "@polymarket-copy/shared": "../../packages/shared/src/index.ts",
    "@nestjs/common": "npm:@nestjs/common@^12.5.0",
    "@nestjs/core": "npm:@nestjs/core@^12.5.0",
    "@nestjs/platform-express": "npm:@nestjs/platform-express@^12.5.0",
    "@nestjs/mongoose": "npm:@nestjs/mongoose@^12.0.1",
    "mongoose": "npm:mongoose@^9.12.1",
    "reflect-metadata": "npm:reflect-metadata@^0.2.2",
    "rxjs": "npm:rxjs@^7.8.2",
    "zod": "npm:zod@^4.6.7",
    "ws": "npm:ws@^8.23.0"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "tasks": {
    "dev": "deno run -A --unsafe-proto --watch src/main.ts",
    "start": "deno run -A --unsafe-proto src/main.ts",
    "test": "deno test -A --unsafe-proto tests/"
  }
}
